{
  "name": "mediasoup-cli",
  "version": "2.0.0",
  "description": "Live terminal monitor for mediasoup servers: workers, routers, transports, producers, consumers, stats and events.",
  "keywords": [
    "mediasoup",
    "webrtc",
    "sfu",
    "cli",
    "monitoring",
    "debugging"
  ],
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "bin": {
    "mediasoup-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "config.env",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w",
    "start": "node dist/index.js",
    "test": "node scripts/test.cjs",
    "test:live": "npm run build && node scripts/test-live.cjs",
    "demo": "node examples/demo-server.js",
    "demo:live": "npm run build && node scripts/test-live.cjs --manual",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/musta20/mediasoup-cli.git"
  },
  "author": "musta20",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/musta20/mediasoup-cli/issues"
  },
  "homepage": "https://github.com/musta20/mediasoup-cli#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "mediasoup": "3.x"
  },
  "peerDependenciesMeta": {
    "mediasoup": {
      "optional": true
    }
  }
}
