{
  "name": "mediasoup-cli",
  "version": "1.0.1",
  "description": "Live terminal monitor for mediasoup servers: workers, routers, transports, producers, consumers, stats and events.",
  "keywords": [
    "mediasoup",
    "webrtc",
    "sfu",
    "cli",
    "monitoring",
    "debugging"
  ],
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "bin": {
    "mediasoup-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "config.env"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w",
    "start": "node dist/index.js",
    "test": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test --test-concurrency=1 \".test-build/test/**/*.test.js\"",
    "demo": "node examples/demo-server.js",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/musta20/mediasoup-cli.git"
  },
  "author": "musta20",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/musta20/mediasoup-cli/issues"
  },
  "homepage": "https://github.com/musta20/mediasoup-cli#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "mediasoup": "3.x"
  },
  "peerDependenciesMeta": {
    "mediasoup": {
      "optional": true
    }
  }
}
